[
 {
  "Id": "f64b81d1d0032be82eb4c393c41e27d8fae7baf343f69fa129db21be87ad7169",
  "Name": "ollama",
  "Config": {
   "CreateCommand": [
    "/usr/bin/podman",
    "run",
    "--name",
    "ollama",
    "--replace",
    "--rm",
    "--cgroups=split",
    "--sdnotify=conmon",
    "-d",
    "--security-opt",
    "label=disable",
    "--device",
    "/dev/kfd",
    "--device",
    "/dev/dri",
    "-v",
    "ollama_data:/root/.ollama",
    "--env",
    "HSA_OVERRIDE_GFX_VERSION=10.3.0",
    "--env",
    "OLLAMA_CONTEXT_LENGTH=32768",
    "--env",
    "OLLAMA_FLASH_ATTENTION=1",
    "--env",
    "OLLAMA_HOST=0.0.0.0:11434",
    "--env",
    "OLLAMA_KV_CACHE_TYPE=q8_0",
    "--env",
    "OLLAMA_MAX_LOADED_MODELS=4",
    "--env",
    "OLLAMA_NUM_PARALLEL=1",
    "--pod",
    "local-ai",
    "docker.io/ollama/ollama:rocm"
   ]
  },
  "HostConfig": {
   "Devices": []
  }
 }
]